# Stage 1: Clone repository and build WAR using Maven
FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /build

# Install Git (Debian-based image)
RUN apt-get update && \
    apt-get install -y git && \
    rm -rf /var/lib/apt/lists/*

# Clone GitHub repository
RUN git clone https://github.com/berahul008/doc-lib-man.git .

WORKDIR /build/library-backend

# Build WAR file
RUN mvn clean package -DskipTests

# Stage 2: Runtime image with Tomcat
FROM tomcat:10.1-jdk17-temurin

# Remove default Tomcat applications
RUN rm -rf /usr/local/tomcat/webapps/*

# Copy generated WAR file
COPY --from=builder /build/library-backend/target/*.war /usr/local/tomcat/webapps/library-backend.war

EXPOSE 8080
CMD ["catalina.sh", "run"]
